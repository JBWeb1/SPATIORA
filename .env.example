# VISTORA server configuration — copy to .env and adjust.
PORT=4000
# Secret used to sign login tokens. Always set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database and uploaded images are stored.
DATA_DIR=./data
# Allowed browser origin for the API in development.
CLIENT_ORIGIN=http://localhost:5173

# --- AI Design Assistant (Claude) -------------------------------------------
# When set, the assistant, room analysis and design briefs use Claude.
# Without it VISTORA falls back to its built-in rule-based design advisor.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- AI image redesign -------------------------------------------------------
# Leave blank to use the built-in "Studio Preview" renderer (no external calls).
# Replicate: any image-to-image interior model version that accepts
# { image, prompt, negative_prompt } inputs.
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
# Or a custom HTTP endpoint: receives JSON { image (data URL), prompt, negativePrompt, style }
# and must respond with { image: "<data URL or https URL>" }.
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_KEY=

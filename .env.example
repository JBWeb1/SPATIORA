# VISTORA server configuration — copy to .env and adjust.
PORT=4000
# Secret used to sign login tokens. Always set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database and uploaded images are stored.
DATA_DIR=./data
# Allowed browser origin for the API in development.
CLIENT_ORIGIN=http://localhost:5173

# --- AI Design Assistant (Claude) -------------------------------------------
# When set, the assistant, room analysis and design briefs use Claude.
# Without it VISTORA falls back to its built-in rule-based design advisor.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- AI image redesign -------------------------------------------------------
# Leave blank to use the built-in "Studio Preview" renderer (no external calls).
# Photo-real redesigns via Replicate (pay per image): set REPLICATE_API_TOKEN.
# The model must accept { image, prompt, negative_prompt, prompt_strength, seed }.
REPLICATE_API_TOKEN=
# Model to use (its latest version is looked up automatically); pin a version if you prefer.
REPLICATE_MODEL=adirik/interior-design
REPLICATE_MODEL_VERSION=
# Or a custom HTTP endpoint: receives JSON { image (data URL), prompt, negativePrompt, style }
# and must respond with { image: "<data URL or https URL>" }.
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_KEY=

# --- Self-updating data --------------------------------------------------------
# Exchange rates refresh automatically (quoted per 1 ZAR). Set to "off" to use built-in rates.
FX_RATES_URL=https://open.er-api.com/v6/latest/ZAR
FX_REFRESH_HOURS=12
# Optional partner product feed: JSON { "products": [ ...full products or { "id", "price" } updates ] }
CATALOG_FEED_URL=
CATALOG_REFRESH_HOURS=6

# --- Admin ----------------------------------------------------------------------
# Comma-separated emails allowed to open the business dashboard at /admin.
ADMIN_EMAILS=
